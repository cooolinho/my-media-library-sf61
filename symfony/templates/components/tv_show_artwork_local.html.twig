<div{{ attributes }}>
    <div class="accordion" id="artworkLocalAccordion">
        {% for type, data in this.media %}
            <div class="accordion-item">
                <h2 class="accordion-header" id="artwork-local-heading{{ type }}">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse"
                            data-bs-target="#artwork-local-collapse{{ type }}" aria-expanded="true"
                            aria-controls="artwork-local-collapse{{ type }}">
                        {{ data.title }}
                    </button>
                </h2>
                <div id="artwork-local-collapse{{ type }}" class="accordion-collapse collapse" aria-labelledby="artwork-local-heading{{ type }}"
                     data-bs-parent="#artworkLocalAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            {% for artwork in data.artworks %}
                                <div class="col-3">
                                    <div class="card">
                                        <a href="#" data-bs-toggle="modal" data-bs-target="#modal-artwork-local-{{ artwork.id }}">
                                            <img src="{{ this.artworkUrl(artwork) }}" class="card-img-top" alt="{{ artwork.filename }}">
                                        </a>
                                    </div>
                                </div>

                                <!-- Modal -->
                                <div class="modal fade" id="modal-artwork-local-{{ artwork.id }}" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modal-artwork-local-{{ artwork.id }}Label" aria-hidden="true">
                                    <div class="modal-dialog modal-xl">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h1 class="modal-title fs-5" id="modal-artwork-local-{{ artwork.id }}Label">{{ artwork.filename }}</h1>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <img src="{{ this.artworkUrl(artwork) }}" class="card-img-top" alt="{{ artwork.filename }}">
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
