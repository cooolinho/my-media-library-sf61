<div class="card">
    <div class="card-body">
        <h2 class="card-title">
            Nicht vollständige TV-Shows
        </h2>
        <div class="card-text">
            <div{{ attributes }}>

                <table class="table table-sm">
                    <tbody>
                    {% for tvShow in this.tvShows %}
                        {% if tvShow.countEpisodesMissing > 1 %}
                            {% set tvShowDetailUrl = ea_url()
                                .setDashboard('App\\Controller\\Admin\\DashboardController')
                                .setController('App\\Controller\\Admin\\TvShowCrudController')
                                .setAction('detail')
                                .setEntityId(tvShow.id)
                                .generateUrl() %}

                            <tr>
                                <td>
                                    <a href="{{ tvShowDetailUrl }}">{{ tvShow.name }}</a>
                                </td>
                                <td>
                                    <div class="progress" role="progressbar" aria-label="Example with label" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: {{ tvShow.totalEpisodesInPercent }}%">{{ tvShow.totalEpisodesInPercent|number_format(0) }}%</div>
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    {% endfor %}
                    </tbody>
                </table>

            </div>
        </div>
    </div>
</div>
