<div{{ attributes }}>
    <div class="accordion" id="artworkAccordion">
        {% for type, data in this.media %}
            <div class="accordion-item">
                <h2 class="accordion-header" id="artwork-heading{{ type }}">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse"
                            data-bs-target="#artwork-collapse{{ type }}" aria-expanded="true"
                            aria-controls="artwork-collapse{{ type }}">
                        {{ data.title }}
                    </button>
                </h2>
                <div id="artwork-collapse{{ type }}" class="accordion-collapse collapse" aria-labelledby="artwork-heading{{ type }}"
                     data-bs-parent="#artworkAccordion">
                    <div class="accordion-body">
                        <div class="row">
                            {% for artwork in data.artworks %}
                                <div class="col-3">
                                    <div class="card">
                                        <img src="{{ artwork.image }}" class="card-img-top" alt="{{ artwork.id }}">
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
