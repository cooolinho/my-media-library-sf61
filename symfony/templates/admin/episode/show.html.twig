{% extends "@!EasyAdmin/crud/detail.html.twig" %}

{% block main %}
    {{ parent() }}

    <hr>

    <div class="episode-card-container">
        <div class="episode-card">
            <span class="episode-badge {{ entity.instance.owned ? 'badge-owned' : 'badge-not-owned' }}"></span>
            <img class="episode-image" src="{{ episode.image }}" alt="Episodenbild">
            <div class="episode-content">
                <div class="episode-title">Staffel {{ episode.seasonNumber }}, Episode {{ episode.number }}: "{{ episode.name }}"</div>
                <div class="episode-info">Laufzeit: {{ episode.runtime }} Minuten | Ausgestrahlt am: {{ episode.aired }}</div>
                <p class="episode-description">
                    {{ episode.overview }}
                </p>
            </div>
        </div>
    </div>
{% endblock %}
