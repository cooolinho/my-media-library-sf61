{
  "name": "cooolinho/tvdbapi-bundle",
  "license": "GPL-2.0-only",
  "version": "1.0.0",
  "type": "symfony-bundle",
  "description": "test reusable bundle",
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "symfony/framework-bundle": "6.1.*",
    "symfony/flex": "^2"
  }
  ,
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Cooolinho\\Bundle\\TVDBApiBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cooolinho\\Bundle\\TVDBApiBundle\\Tests\\": "tests/"
    }
  }
}
